# .env.example — copy to .env and fill in all values

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://top10prom.store
NEXT_PUBLIC_DEFAULT_BOUTIQUE_SLUG=demo

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Rate Limiting (Upstash) ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Must match exactly what the code reads: process.env.RESEND_FROM
RESEND_FROM=Top 10 Prom <noreply@top10prom.com>

# ── Maps ───────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=