# .env.example — copy to .env.local and fill in all values

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://top10prom.store
NEXT_PUBLIC_DEFAULT_BOUTIQUE_SLUG=demo

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Rate Limiting (Upstash) ───────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend — Phase 1G) ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@top10prom.com
